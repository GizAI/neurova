      "bucket": "code",
      "paths": ["saneflow/data/corpus/sft_sources/opencodeinstruct_direct.jsonl"],
      "limit": 3200
    },
    {
      "name": "bespoke_stratos_17k",
      "type": "jsonl",
      "bucket": "reasoning",
      "paths": ["saneflow/data/corpus/sft_sources/bespoke_stratos_17k.jsonl"],
      "limit": 2500
    },
    {
      "name": "limo",
      "type": "jsonl",
