{
  "name": "saneflow_chatml_sft_v1",
  "format": "chatml",
  "loss_mode": "chatml_assistant",
  "target_records": 24000,
  "valid_records": 2000,
  "max_chars": {
    "default": 2200,
    "reasoning": 4200,
    "code": 3200,
    "tool": 2800,
    "smoltalk2": 4200,
    "tulu3": 2800,
    "korean": 2200,
    "safety": 1800
  },
  "buckets": {
    "tulu3": 0.25,
    "smoltalk2": 0.20,
    "reasoning": 0.25,
    "code": 0.15,
    "tool": 0.07,
    "korean": 0.05,
    "safety": 0.03
  },
  "sources": [
    {
      "name": "openr1_math_220k",
      "type": "jsonl",
      "bucket": "reasoning",
      "paths": ["saneflow/data/corpus/sft_sources/openr1_math_220k.jsonl"],
      "limit": 2500
    },
    {
      "name": "smoltalk2_direct",
      "type": "jsonl",
      "bucket": "smoltalk2",
      "paths": ["saneflow/data/corpus/sft_sources/smoltalk2_direct.jsonl"],
      "limit": 5000
    },
    {
