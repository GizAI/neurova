{
  "name": "saneflow_practical_pretrain_sources_v1",
  "description": "Bounded high-quality continuation sources for the next practical base pretrain. These are not SFT or ChatML targets.",
  "sources": [
    {
      "name": "fineweb_edu_sample10bt",
      "dataset": "HuggingFaceFW/fineweb-edu",
      "config": "sample-10BT",
      "split": "train",
      "out_dir": "saneflow/data/corpus/sources/fineweb_edu_sample10bt",
      "max_train_bytes": 200000000,
      "max_valid_bytes": 5000000,
      "language": "en",
      "domain": "educational_web",
      "enabled": false,
      "note": "Already prepared; kept here as the baseline source."
    },
    {
      "name": "dclm_baseline_v1",
      "dataset": "mlfoundations/dclm-baseline-1.0",
      "config": null,
      "split": "train",
      "out_dir": "saneflow/data/corpus/sources/dclm_baseline_v1",
      "max_train_bytes": 300000000,
      "max_valid_bytes": 8000000,
      "language": "en",
      "domain": "filtered_web",
      "enabled": true
    },
    {
      "name": "gneissweb_v1",
      "dataset": "ibm-granite/GneissWeb",
      "config": null,
      "split": "train",
      "out_dir": "saneflow/data/corpus/sources/gneissweb_v1",
      "max_train_bytes": 300000000,
      "max_valid_bytes": 8000000,
      "language": "en",
      "domain": "filtered_web",
      "enabled": false,
      "note": "IBM GneissWeb is a high-quality text pretraining recipe/dataset, but the current HF default config exposes only an image column in this environment. Enable only after a text shard/config is verified."
    },
    {
      "name": "fineweb2_hq_en",
      "dataset": "epfml/FineWeb2-HQ",
      "config": "en",
      "split": "train",
      "out_dir": "saneflow/data/corpus/sources/fineweb2_hq_en",
      "max_train_bytes": 120000000,
      "max_valid_bytes": 4000000,
      "language": "en",
      "domain": "multilingual_hq_web",
      "enabled": true
    },
    {
      "name": "fineweb2_hq_ko",
      "dataset": "epfml/FineWeb2-HQ",
      "config": "ko",
      "split": "train",
      "out_dir": "saneflow/data/corpus/sources/fineweb2_hq_ko",
      "max_train_bytes": 80000000,
      "max_valid_bytes": 3000000,
      "language": "ko",
      "domain": "multilingual_hq_web",
      "enabled": true
    }
  ]
}
