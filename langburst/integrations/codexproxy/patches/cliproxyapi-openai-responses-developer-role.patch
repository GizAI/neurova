+func TestConvertOpenAIResponsesRequestToOpenAIChatCompletions_DeveloperBecomesSystem(t *testing.T) {
+	raw := []byte(`{
+		"input": [
+			{"type":"message","role":"developer","content":[{"type":"input_text","text":"system rules"}]},
+			{"type":"message","role":"user","content":[{"type":"input_text","text":"hello"}]}
+		]
+	}`)
+
+	out := ConvertOpenAIResponsesRequestToOpenAIChatCompletions("openai-compatible", raw, false)
+
+	if got := gjson.GetBytes(out, "messages.0.role").String(); got != "system" {
+		t.Fatalf("messages.0.role = %q, want system; output=%s", got, prettyJSONForTest(out))
+	}
+	if got := gjson.GetBytes(out, "messages.0.content.0.text").String(); got != "system rules" {
+		t.Fatalf("messages.0.content.0.text = %q, want system rules; output=%s", got, prettyJSONForTest(out))
+	}
+	if got := gjson.GetBytes(out, "messages.1.role").String(); got != "user" {
+		t.Fatalf("messages.1.role = %q, want user; output=%s", got, prettyJSONForTest(out))
+	}
+}
