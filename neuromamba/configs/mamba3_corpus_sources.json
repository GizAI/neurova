      "license": "CommonCrawl-ToU",
      "domain": "web",
      "quality_score": 0.86,
      "out": "neuromamba/data/governed_nemotron_cc_sample.jsonl",
      "status": "index_available_raw_downloader_needed"
    }
  ]
}
